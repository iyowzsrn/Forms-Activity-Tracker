{
  "manifest_version": 3,
  "name": "Exam Focus Logger",
  "version": "4.0.0",
  "description": "With the student's consent, logs activity and restricts browsing during exams scheduled by the teacher.",
  "permissions": ["tabs", "storage", "identity", "identity.email", "webNavigation", "alarms"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Exam Focus Logger",
    "default_popup": "popup.html"
  }
}
